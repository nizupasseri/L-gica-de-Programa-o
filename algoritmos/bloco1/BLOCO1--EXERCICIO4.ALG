Algoritmo "bloco1--exercicio4"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gabriel Sena
// Descrição   : Leia a idade de uma pessoa e mostre quantos meses completos ela já viveu, considerando 12 meses por ano
// Autor(a)    : Nicollas Passeri
// Data atual  : 02/11/2026
Var
   idade,meses : inteiro
Inicio
      escreval("Insira a sua idade em anos: ")
      leia(idade)
      meses <- idade*12
      escreval("Você já viveu", meses, " meses completos!")
Fimalgoritmo