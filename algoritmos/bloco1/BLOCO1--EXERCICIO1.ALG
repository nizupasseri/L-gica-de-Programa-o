Algoritmo "bloco1--exercicio1"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gabriel Sena
// Descrição   : Leia dois números inteiros e mostre a soma.
// Autor(a)    : Nicollas Passeri
// Data atual  : 02/11/2026
Var
   numero1,numero2,soma : inteiro
Inicio
      escreval("Calculadora de soma simples")
      escreval("---------------------------")
      escreval("Insira o primeiro número: ")
      leia(numero1)
      escreval("Insira o segundo número: ")
      leia(numero2)
      soma <- numero1+numero2
      escreval(soma)
Fimalgoritmo